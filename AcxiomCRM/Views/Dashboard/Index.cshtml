@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Welcome back, @Model.UserDisplayName</h2>
        <p class="text-secondary small mb-0">Role Scope: <span class="badge bg-primary text-white">@Model.UserRole</span> &middot; Here is your sales pipeline and activity summary.</p>
    </div>

    <!-- Date Filters -->
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm @(Model.DateFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
            <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-sm @(Model.DateFilter == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
            <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm @(Model.DateFilter == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
            <a asp-action="Index" asp-route-dateFilter="AllTime" class="btn btn-sm @(Model.DateFilter == "AllTime" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        </div>
    </div>
</div>

<!-- Mandatory KPI Cards (Section 17.11) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Customers</div>
                <div class="kpi-value text-primary">@Model.TotalCustomers</div>
            </div>
            <div class="kpi-icon primary"><i class="fa-solid fa-users"></i></div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Total Leads</div>
                <div class="kpi-value text-info">@Model.TotalLeads</div>
                <div class="small text-muted mt-1">@Model.OpenLeads Open</div>
            </div>
            <div class="kpi-icon info"><i class="fa-solid fa-bullseye"></i></div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Opportunities</div>
                <div class="kpi-value text-purple">@Model.TotalOpportunities</div>
                <div class="small text-muted mt-1">@Model.OpenOpportunities Open</div>
            </div>
            <div class="kpi-icon purple"><i class="fa-solid fa-handshake"></i></div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Deals Won</div>
                <div class="kpi-value text-success">@Model.WonOpportunities</div>
                <div class="small text-muted mt-1">@Model.LostOpportunities Lost</div>
            </div>
            <div class="kpi-icon success"><i class="fa-solid fa-trophy"></i></div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Open Pipeline</div>
                <div class="kpi-value text-dark" style="font-size: 1.35rem;">@Model.TotalPipelineValue.ToString("C0")</div>
                <div class="small text-muted mt-1">Wgt: @Model.WeightedPipelineValue.ToString("C0")</div>
            </div>
            <div class="kpi-icon warning"><i class="fa-solid fa-sack-dollar"></i></div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div>
                <div class="kpi-title">Follow-Ups</div>
                <div class="kpi-value @(Model.OverdueFollowUpsCount > 0 ? "text-danger" : "text-primary")">@Model.PendingFollowUpsCount</div>
                <div class="small text-danger mt-1">@(Model.OverdueFollowUpsCount > 0 ? $"{Model.OverdueFollowUpsCount} Overdue" : "0 Overdue")</div>
            </div>
            <div class="kpi-icon danger"><i class="fa-solid fa-calendar-check"></i></div>
        </div>
    </div>
</div>

<!-- Mandatory Charts (Section 17.12: Chart.js) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-4">
        <div class="card card-crm h-100">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-chart-pie me-2 text-primary"></i> Lead Status Breakdown</span>
            </div>
            <div class="card-body-crm d-flex align-items-center justify-content-center" style="min-height: 280px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card card-crm h-100">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-chart-column me-2 text-success"></i> Opportunity Pipeline</span>
            </div>
            <div class="card-body-crm" style="min-height: 280px;">
                <canvas id="pipelineChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card card-crm h-100">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-arrow-trend-up me-2 text-warning"></i> Monthly Sales Outcomes</span>
            </div>
            <div class="card-body-crm" style="min-height: 280px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tables: Recent Opportunities & Upcoming Follow-ups -->
<div class="row g-3">
    <div class="col-12 col-lg-7">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-handshake me-2 text-primary"></i> Active Opportunities</span>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-outline-secondary btn-sm py-1">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-crm mb-0">
                    <thead>
                        <tr>
                            <th>Deal Name</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentOpportunities.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No opportunities found.</td></tr>
                        }
                        @foreach (var opp in Model.RecentOpportunities)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-bold text-decoration-none text-dark">
                                        @opp.OpportunityName
                                    </a>
                                </td>
                                <td>@(opp.Customer?.CustomerName ?? "—")</td>
                                <td>
                                    <span class="badge-status @opp.Stage.ToLower()">@opp.Stage</span>
                                </td>
                                <td class="fw-bold text-dark">@opp.Amount.ToString("C0")</td>
                                <td>@opp.Probability%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-calendar-day me-2 text-warning"></i> Scheduled Follow-Ups</span>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-outline-secondary btn-sm py-1">View All</a>
            </div>
            <div class="card-body-crm p-0">
                <div class="list-group list-group-flush">
                    @if (!Model.UpcomingFollowUps.Any())
                    {
                        <div class="text-center text-muted py-4">No pending follow-ups scheduled.</div>
                    }
                    @foreach (var f in Model.UpcomingFollowUps)
                    {
                        <div class="list-group-item p-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-dark border small"><i class="fa-solid fa-tag me-1"></i> @f.FollowUpType</span>
                                <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> @f.FollowUpDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="fw-bold text-dark">@f.Subject</div>
                            <div class="text-secondary small">@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "General Activity")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart 1: Lead Status
            const leadLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels));
            const leadData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts));

            new Chart(document.getElementById('leadStatusChart'), {
                type: 'doughnut',
                data: {
                    labels: leadLabels,
                    datasets: [{
                        data: leadData,
                        backgroundColor: ['#3b82f6', '#f59e0b', '#10b981', '#8b5cf6', '#ef4444'],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11 } } }
                    }
                }
            });

            // Chart 2: Pipeline
            const pipeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels));
            const pipeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageValues));

            new Chart(document.getElementById('pipelineChart'), {
                type: 'bar',
                data: {
                    labels: pipeLabels,
                    datasets: [{
                        label: 'Value ($)',
                        data: pipeData,
                        backgroundColor: '#3b82f6',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            // Chart 3: Monthly Sales
            const monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels));
            const monthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesValues));

            new Chart(document.getElementById('monthlySalesChart'), {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Won Deals ($)',
                        data: monthData,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4,
                        pointBackgroundColor: '#10b981'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        });
    </script>
}
