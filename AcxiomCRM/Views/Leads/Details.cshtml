@model AcxiomCRM.ViewModels.LeadDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Lead.LeadName} - Lead Overview";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Leads</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">@Model.Lead.LeadName</span>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">@Model.Lead.LeadName</h2>
            <span class="badge bg-light text-secondary border">@Model.Lead.LeadCode</span>
            <span class="badge-status @Model.Lead.Status.ToLower()">@Model.Lead.Status</span>
        </div>
        <p class="text-secondary small mb-0">@(Model.Lead.CompanyName ?? "Direct Prospect") &middot; Created on @Model.Lead.CreatedDate.ToString("MMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Lead.LeadId" class="btn btn-crm-outline">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
        </a>
        @if (Model.Lead.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.Lead.LeadId" class="btn btn-crm-primary">
                <i class="fa-solid fa-arrow-right-arrow-left me-1"></i> Convert Lead
            </a>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-outline-secondary">
            <i class="fa-solid fa-calendar-plus me-1"></i> Add Follow-Up
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="card card-crm mb-4">
            <div class="card-header-crm">
                <span>Lead Intelligence</span>
            </div>
            <div class="card-body-crm">
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Email</div>
                    <div class="fw-semibold text-dark">@Model.Lead.Email</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Phone</div>
                    <div class="fw-semibold text-dark">@Model.Lead.Phone</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Lead Source</div>
                    <div class="badge bg-light text-dark border">@Model.Lead.Source</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Priority</div>
                    <div>@Model.Lead.Priority</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Expected Deal Value</div>
                    <div class="fw-bold fs-5 text-success">@Model.Lead.ExpectedValue.ToString("C0")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Assigned Representative</div>
                    <div class="fw-bold text-primary">@(Model.Lead.AssignedUser?.FullName ?? "Unassigned")</div>
                </div>
                @if (Model.Lead.ConvertedCustomer != null)
                {
                    <div class="p-3 bg-light rounded-3 mt-3 border">
                        <div class="text-muted small fw-semibold text-uppercase">Converted To Customer</div>
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Lead.ConvertedCustomer.CustomerId" class="fw-bold text-primary text-decoration-none">
                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> @Model.Lead.ConvertedCustomer.CustomerName
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Lead.Notes))
        {
            <div class="card card-crm">
                <div class="card-header-crm"><span>Discovery Notes</span></div>
                <div class="card-body-crm">
                    <p class="text-secondary small mb-0" style="white-space: pre-line;">@Model.Lead.Notes</p>
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-lg-8">
        <!-- Follow-Ups -->
        <div class="card card-crm mb-4">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-calendar-check me-2 text-warning"></i> Follow-Up Log (@Model.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-sm btn-outline-warning py-1">Schedule</a>
            </div>
            <div class="card-body-crm p-0">
                <div class="list-group list-group-flush">
                    @if (!Model.FollowUps.Any())
                    {
                        <div class="text-center py-4 text-muted">No follow-ups recorded yet.</div>
                    }
                    @foreach (var f in Model.FollowUps)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-secondary border small">@f.FollowUpType</span>
                                <span class="badge-status @f.Status.ToLower()">@f.Status</span>
                            </div>
                            <div class="fw-bold text-dark">@f.Subject</div>
                            <p class="text-secondary small mb-1">@(f.Remarks ?? "")</p>
                            <span class="text-muted small"><i class="fa-regular fa-calendar me-1"></i> @f.FollowUpDate.ToString("g")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Activities -->
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-clock-rotate-left me-2 text-info"></i> Activities History (@Model.Activities.Count)</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-sm btn-outline-info py-1">Log Activity</a>
            </div>
            <div class="card-body-crm p-0">
                <div class="list-group list-group-flush">
                    @if (!Model.Activities.Any())
                    {
                        <div class="text-center py-4 text-muted">No activities logged.</div>
                    }
                    @foreach (var a in Model.Activities)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between">
                                <div class="fw-bold text-dark">@a.Subject <span class="badge bg-light text-muted border small ms-1">@a.ActivityType</span></div>
                                <span class="text-muted small">@a.ActivityDate.ToString("g")</span>
                            </div>
                            <div class="small text-secondary mt-1">@(a.Description ?? "")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
