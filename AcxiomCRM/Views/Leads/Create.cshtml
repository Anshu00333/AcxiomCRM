@model AcxiomCRM.ViewModels.LeadCreateEditViewModel
@{
    ViewData["Title"] = "Capture New Lead";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Leads</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">New Lead</span>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-bullseye me-2 text-primary"></i> Capture Lead Record</span>
            </div>
            <div class="card-body-crm">
                <form asp-action="Create" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label-crm">Lead / Prospect Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control form-control-crm" placeholder="e.g. Marcus Bennett" />
                            <span asp-validation-for="LeadName" class="text-danger-validation"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label-crm">Company / Organization</label>
                            <input asp-for="CompanyName" class="form-control form-control-crm" placeholder="e.g. BluePeak Technologies" />
                            <span asp-validation-for="CompanyName" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label-crm">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control form-control-crm" placeholder="lead@company.com" />
                            <span asp-validation-for="Email" class="text-danger-validation"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label-crm">Phone (10 digits) <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control form-control-crm" placeholder="9811223344" maxlength="15" />
                            <span asp-validation-for="Phone" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Source" class="form-label-crm">Lead Source <span class="text-danger">*</span></label>
                            <select asp-for="Source" class="form-select form-select-crm">
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="Trade Show">Trade Show</option>
                                <option value="Cold Call">Cold Call</option>
                                <option value="Email Campaign">Email Campaign</option>
                                <option value="Partner">Partner</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger-validation"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label-crm">Initial Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select form-select-crm">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger-validation"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label-crm">Priority</label>
                            <select asp-for="Priority" class="form-select form-select-crm">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label-crm">Expected Deal Value ($)</label>
                            <input asp-for="ExpectedValue" class="form-control form-control-crm" type="number" step="0.01" min="0" placeholder="50000.00" />
                            <span asp-validation-for="ExpectedValue" class="text-danger-validation"></span>
                        </div>

                        @if (!User.IsInRole("SalesExecutive"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label-crm">Assigned Representative</label>
                                <select asp-for="AssignedTo" asp-items="Model.SalesUsers" class="form-select form-select-crm">
                                    <option value="">-- Assign Sales User --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger-validation"></span>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label-crm">Discovery Notes</label>
                        <textarea asp-for="Notes" rows="3" class="form-control form-control-crm" placeholder="Specific interests, requirements, or conversation summaries..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger-validation"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-crm-outline">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="fa-solid fa-check me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
