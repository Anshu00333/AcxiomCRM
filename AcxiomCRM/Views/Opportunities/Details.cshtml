@model AcxiomCRM.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Opportunity.OpportunityName} - Details";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Opportunities</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">@Model.Opportunity.OpportunityName</span>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">@Model.Opportunity.OpportunityName</h2>
            <span class="badge-status @Model.Opportunity.Stage.ToLower()">@Model.Opportunity.Stage</span>
            <span class="badge bg-light text-secondary border">Status: @Model.Opportunity.Status</span>
        </div>
        <p class="text-secondary small mb-0">Created on @Model.Opportunity.CreatedDate.ToString("MMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-crm-outline">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Opportunity.CustomerId" class="btn btn-crm-primary">
            <i class="fa-solid fa-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="card card-crm mb-4">
            <div class="card-header-crm">
                <span>Deal Breakdown</span>
            </div>
            <div class="card-body-crm">
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Total Deal Amount</div>
                    <div class="fw-bold fs-4 text-primary">@Model.Opportunity.Amount.ToString("C0")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Win Probability</div>
                    <div class="fw-bold text-dark">@Model.Opportunity.Probability%</div>
                    <div class="progress mt-1" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.Opportunity.Probability%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Weighted Forecast Value</div>
                    <div class="fw-bold text-success fs-5">@Model.Opportunity.WeightedAmount.ToString("C0")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Target Close Date</div>
                    <div class="fw-semibold text-dark">@Model.Opportunity.ExpectedCloseDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Account / Client</div>
                    @if (Model.Opportunity.Customer != null)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Opportunity.Customer.CustomerId" class="fw-bold text-primary text-decoration-none">
                            @Model.Opportunity.Customer.CustomerName
                        </a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
                <div class="pt-3 border-top">
                    <div class="text-muted small fw-semibold text-uppercase">Assigned Representative</div>
                    <div class="fw-bold text-dark">@(Model.Opportunity.AssignedUser?.FullName ?? "Unassigned")</div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Opportunity.Notes))
        {
            <div class="card card-crm">
                <div class="card-header-crm"><span>Deal Notes</span></div>
                <div class="card-body-crm">
                    <p class="text-secondary small mb-0" style="white-space: pre-line;">@Model.Opportunity.Notes</p>
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-lg-8">
        <!-- Follow-Ups -->
        <div class="card card-crm mb-4">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-calendar-check me-2 text-warning"></i> Associated Follow-Ups (@Model.FollowUps.Count)</span>
            </div>
            <div class="card-body-crm p-0">
                <div class="list-group list-group-flush">
                    @if (!Model.FollowUps.Any())
                    {
                        <div class="text-center py-4 text-muted">No follow-ups recorded yet.</div>
                    }
                    @foreach (var f in Model.FollowUps)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-secondary border small">@f.FollowUpType</span>
                                <span class="badge-status @f.Status.ToLower()">@f.Status</span>
                            </div>
                            <div class="fw-bold text-dark">@f.Subject</div>
                            <p class="text-secondary small mb-1">@(f.Remarks ?? "")</p>
                            <span class="text-muted small"><i class="fa-regular fa-calendar me-1"></i> @f.FollowUpDate.ToString("g")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
