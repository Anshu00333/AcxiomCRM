@model AcxiomCRM.ViewModels.OpportunityCreateEditViewModel
@{
    ViewData["Title"] = "New Opportunity";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Opportunities</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">New Opportunity</span>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-handshake me-2 text-primary"></i> Create Sales Opportunity</span>
            </div>
            <div class="card-body-crm">
                <form asp-action="Create" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label-crm">Opportunity / Deal Name <span class="text-danger">*</span></label>
                        <input asp-for="OpportunityName" class="form-control form-control-crm" placeholder="e.g. Enterprise Cloud Modernization" />
                        <span asp-validation-for="OpportunityName" class="text-danger-validation"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label-crm">Related Customer</label>
                            <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select form-select-crm">
                                <option value="">-- Select Customer Account --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger-validation"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label-crm">Related Lead</label>
                            <select asp-for="LeadId" asp-items="Model.Leads" class="form-select form-select-crm">
                                <option value="">-- Select Originating Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label-crm">Deal Amount ($) <span class="text-danger">*</span></label>
                            <input asp-for="Amount" class="form-control form-control-crm" type="number" step="0.01" min="0.01" placeholder="75000.00" />
                            <span asp-validation-for="Amount" class="text-danger-validation"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label-crm">Win Probability (%) (0 - 100) <span class="text-danger">*</span></label>
                            <input asp-for="Probability" class="form-control form-control-crm" type="number" min="0" max="100" placeholder="50" />
                            <span asp-validation-for="Probability" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label-crm">Pipeline Stage <span class="text-danger">*</span></label>
                            <select asp-for="Stage" class="form-select form-select-crm" id="stageSelect">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger-validation"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label-crm">Expected Close Date <span class="text-danger">*</span></label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control form-control-crm" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger-validation"></span>
                        </div>
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedTo" class="form-label-crm">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" asp-items="Model.SalesUsers" class="form-select form-select-crm">
                                <option value="">-- Assign Representative --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger-validation"></span>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label-crm">Strategy Notes</label>
                        <textarea asp-for="Notes" rows="3" class="form-control form-control-crm" placeholder="Key decision makers, competition, required deliverables..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger-validation"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-crm-outline">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="fa-solid fa-check me-1"></i> Save Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
