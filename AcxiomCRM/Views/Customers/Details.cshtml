@model AcxiomCRM.ViewModels.CustomerDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Customer.CustomerName} - Details";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Customers</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">@Model.Customer.CustomerName</span>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">@Model.Customer.CustomerName</h2>
            <span class="badge bg-light text-secondary border">@Model.Customer.CustomerCode</span>
            <span class="badge-status @Model.Customer.Status.ToLower()">@Model.Customer.Status</span>
        </div>
        <p class="text-secondary small mb-0">@(Model.Customer.CompanyName ?? "Individual Account") &middot; Added on @Model.Customer.CreatedDate.ToString("MMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-crm-outline">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
        </a>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-crm-primary">
            <i class="fa-solid fa-plus me-1"></i> New Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-outline-secondary">
            <i class="fa-solid fa-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Master Profile -->
    <div class="col-12 col-lg-4">
        <div class="card card-crm mb-4">
            <div class="card-header-crm">
                <span>Account Profile</span>
            </div>
            <div class="card-body-crm">
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Email Address</div>
                    <div class="fw-semibold text-dark">@Model.Customer.Email</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Phone</div>
                    <div class="fw-semibold text-dark">@Model.Customer.Phone</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Company</div>
                    <div>@(Model.Customer.CompanyName ?? "—")</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase">Address</div>
                    <div>@(Model.Customer.Address ?? "—")</div>
                    <div>@Model.Customer.City, @Model.Customer.State</div>
                </div>
                <div class="pt-3 border-top">
                    <div class="text-muted small fw-semibold text-uppercase">Assigned Representative</div>
                    <div class="fw-bold text-primary">@(Model.Customer.AssignedUser?.FullName ?? "Unassigned")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Tabs for Related Opportunities, Follow-ups, Activities -->
    <div class="col-12 col-lg-8">
        <!-- Opportunities Section -->
        <div class="card card-crm mb-4">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-handshake me-2 text-primary"></i> Linked Opportunities (@Model.Opportunities.Count)</span>
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-primary py-1">Add Deal</a>
            </div>
            <div class="table-responsive">
                <table class="table table-crm mb-0">
                    <thead>
                        <tr>
                            <th>Deal</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Target Close</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Opportunities.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">No opportunities attached to this customer.</td></tr>
                        }
                        @foreach (var opp in Model.Opportunities)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-bold text-dark text-decoration-none">
                                        @opp.OpportunityName
                                    </a>
                                </td>
                                <td><span class="badge-status @opp.Stage.ToLower()">@opp.Stage</span></td>
                                <td class="fw-bold text-dark">@opp.Amount.ToString("C0")</td>
                                <td>@opp.Probability%</td>
                                <td>@opp.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Follow-Ups Section -->
        <div class="card card-crm mb-4">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-calendar-check me-2 text-warning"></i> Follow-Up Log (@Model.FollowUps.Count)</span>
            </div>
            <div class="card-body-crm p-0">
                <div class="list-group list-group-flush">
                    @if (!Model.FollowUps.Any())
                    {
                        <div class="text-center py-4 text-muted">No follow-ups recorded.</div>
                    }
                    @foreach (var f in Model.FollowUps)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-secondary border small">@f.FollowUpType</span>
                                <span class="badge-status @f.Status.ToLower()">@f.Status</span>
                            </div>
                            <div class="fw-bold text-dark">@f.Subject</div>
                            <p class="text-secondary small mb-1">@(f.Remarks ?? "No remarks added.")</p>
                            <span class="text-muted small"><i class="fa-regular fa-calendar me-1"></i> @f.FollowUpDate.ToString("g")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Activity History -->
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-clock-rotate-left me-2 text-info"></i> Activity History (@Model.Activities.Count)</span>
            </div>
            <div class="card-body-crm p-0">
                <div class="list-group list-group-flush">
                    @if (!Model.Activities.Any())
                    {
                        <div class="text-center py-4 text-muted">No activities logged yet.</div>
                    }
                    @foreach (var a in Model.Activities)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex justify-content-between">
                                <div class="fw-bold text-dark">@a.Subject <span class="badge bg-light text-muted border small ms-1">@a.ActivityType</span></div>
                                <span class="text-muted small">@a.ActivityDate.ToString("g")</span>
                            </div>
                            <div class="small text-secondary mt-1">@(a.Description ?? "")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
