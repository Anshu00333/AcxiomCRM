@model AcxiomCRM.ViewModels.CustomerCreateEditViewModel
@{
    ViewData["Title"] = "New Customer";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Customers</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">New Customer</span>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-user-plus me-2 text-primary"></i> Create Customer Profile</span>
            </div>
            <div class="card-body-crm">
                <form asp-action="Create" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label-crm">Customer / Contact Name <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control form-control-crm" placeholder="e.g. Johnathan Vance" />
                            <span asp-validation-for="CustomerName" class="text-danger-validation"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label-crm">Company Name</label>
                            <input asp-for="CompanyName" class="form-control form-control-crm" placeholder="e.g. Apex Global Corp" />
                            <span asp-validation-for="CompanyName" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label-crm">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control form-control-crm" placeholder="client@company.com" />
                            <span asp-validation-for="Email" class="text-danger-validation"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label-crm">Phone Number (10 digits) <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control form-control-crm" placeholder="9876543210" maxlength="15" />
                            <span asp-validation-for="Phone" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label-crm">Street Address</label>
                        <input asp-for="Address" class="form-control form-control-crm" placeholder="Suite 400, Innovation Blvd" />
                        <span asp-validation-for="Address" class="text-danger-validation"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="City" class="form-label-crm">City</label>
                            <input asp-for="City" class="form-control form-control-crm" placeholder="Chicago" />
                            <span asp-validation-for="City" class="text-danger-validation"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="State" class="form-label-crm">State / Region</label>
                            <input asp-for="State" class="form-control form-control-crm" placeholder="IL" />
                            <span asp-validation-for="State" class="text-danger-validation"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label-crm">Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select form-select-crm">
                                <option value="Active">Active</option>
                                <option value="Prospect">Prospect</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger-validation"></span>
                        </div>
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="mb-4">
                            <label asp-for="AssignedTo" class="form-label-crm">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" asp-items="Model.SalesUsers" class="form-select form-select-crm">
                                <option value="">-- Assign Representative --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger-validation"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-crm-outline">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="fa-solid fa-check me-1"></i> Save Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
