@model AcxiomCRM.ViewModels.ActivityCreateEditViewModel
@{
    ViewData["Title"] = "Log Activity";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Activities</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">Log Activity</span>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-phone me-2 text-primary"></i> Log Activity Interaction</span>
            </div>
            <div class="card-body-crm">
                <form asp-action="Create" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label-crm">Activity Type <span class="text-danger">*</span></label>
                            <select asp-for="ActivityType" class="form-select form-select-crm">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger-validation"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label-crm">Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="ActivityDate" type="datetime-local" class="form-control form-control-crm" />
                            <span asp-validation-for="ActivityDate" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label-crm">Subject / Summary <span class="text-danger">*</span></label>
                        <input asp-for="Subject" class="form-control form-control-crm" placeholder="e.g. Discussed SLA terms and implementation dates" />
                        <span asp-validation-for="Subject" class="text-danger-validation"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label-crm">Related Customer</label>
                            <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select form-select-crm">
                                <option value="">-- None / Select Customer --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label-crm">Related Lead</label>
                            <select asp-for="LeadId" asp-items="Model.Leads" class="form-select form-select-crm">
                                <option value="">-- None / Select Lead --</option>
                            </select>
                        </div>
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedTo" class="form-label-crm">Logged For / Representative</label>
                            <select asp-for="AssignedTo" asp-items="Model.SalesUsers" class="form-select form-select-crm">
                                <option value="">-- Assign User --</option>
                            </select>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label-crm">Interaction Details / Notes</label>
                        <textarea asp-for="Description" rows="4" class="form-control form-control-crm" placeholder="Key points discussed, questions answered, action items..."></textarea>
                        <span asp-validation-for="Description" class="text-danger-validation"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-crm-outline">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="fa-solid fa-check me-1"></i> Log Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
