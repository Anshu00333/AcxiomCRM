@model AcxiomCRM.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">User Administration</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">Create User</span>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-user-plus me-2 text-primary"></i> Create System User</span>
            </div>
            <div class="card-body-crm">
                <form asp-action="Create" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label-crm">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-crm" placeholder="e.g. Rachel Green" />
                        <span asp-validation-for="FullName" class="text-danger-validation"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-crm">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control form-control-crm" placeholder="rachel@acxiomcrm.com" />
                        <span asp-validation-for="Email" class="text-danger-validation"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label-crm">Assigned Primary Role <span class="text-danger">*</span></label>
                            <select asp-for="Role" asp-items="Model.AvailableRoles" class="form-select form-select-crm"></select>
                            <span asp-validation-for="Role" class="text-danger-validation"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label-crm">Department</label>
                            <input asp-for="Department" class="form-control form-control-crm" placeholder="Enterprise Sales" />
                            <span asp-validation-for="Department" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label-crm">Initial Password <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control form-control-crm" placeholder="Min. 8 characters (uppercase, lowercase, number, symbol)" />
                        <span asp-validation-for="Password" class="text-danger-validation"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-crm-outline">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="fa-solid fa-check me-1"></i> Provision Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
