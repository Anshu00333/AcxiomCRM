@model AcxiomCRM.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Admin Reset Password";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">User Administration</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">Reset Password</span>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-key me-2 text-warning"></i> Reset Password: @Model.FullName</span>
            </div>
            <div class="card-body-crm">
                <p class="text-secondary small mb-3">
                    As an administrator, you are securely provisioning a new password for <strong>@Model.UserEmail</strong>.
                </p>

                <form asp-action="ResetPassword" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label-crm">New Password <span class="text-danger">*</span></label>
                        <input asp-for="NewPassword" type="password" class="form-control form-control-crm" placeholder="Enter compliant password" />
                        <div class="form-text small text-muted">Must be at least 8 chars with uppercase, lowercase, number, and symbol.</div>
                        <span asp-validation-for="NewPassword" class="text-danger-validation"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label-crm">Confirm Password <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-crm" placeholder="Re-type new password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger-validation"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-crm-outline">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="fa-solid fa-lock me-1"></i> Update Credentials
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
