@model AcxiomCRM.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">User Administration</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">Edit User</span>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card card-crm">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-user-pen me-2 text-primary"></i> Edit Account: @Model.Email</span>
            </div>
            <div class="card-body-crm">
                <form asp-action="Edit" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label-crm">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-crm" />
                        <span asp-validation-for="FullName" class="text-danger-validation"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-crm text-muted">Email (Username)</label>
                        <input value="@Model.Email" class="form-control form-control-crm bg-light" disabled />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label-crm">Role Assignment <span class="text-danger">*</span></label>
                            <select asp-for="Role" asp-items="Model.AvailableRoles" class="form-select form-select-crm"></select>
                            <span asp-validation-for="Role" class="text-danger-validation"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label-crm">Department</label>
                            <input asp-for="Department" class="form-control form-control-crm" />
                            <span asp-validation-for="Department" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="card p-3 mb-4 bg-light border rounded-3">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsActive" class="form-check-input" id="checkActive" />
                            <label class="form-check-label fw-bold text-dark" for="checkActive">Account Enabled / Active</label>
                        </div>
                        <div class="small text-muted mb-3">Deactivated accounts cannot authenticate to the application.</div>

                        <div class="form-check form-switch">
                            <input asp-for="UnlockAccount" class="form-check-input" id="checkUnlock" />
                            <label class="form-check-label fw-bold text-dark" for="checkUnlock">Reset Lockout & Clear Failed Logins</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-crm-outline">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="fa-solid fa-check me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
