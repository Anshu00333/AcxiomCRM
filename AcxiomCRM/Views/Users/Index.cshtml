@model AcxiomCRM.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User & Access Administration";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">User & Role Management</h2>
        <p class="text-secondary small mb-0">System administration: manage application users, role assignments, lockouts, and credentials.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-crm-primary">
            <i class="fa-solid fa-user-plus"></i> New User
        </a>
    </div>
</div>

<div class="card card-crm">
    <div class="card-header-crm">
        <span>Active & Inactive System Accounts (@Model.Users.Count total)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-crm mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email Address</th>
                    <th>Assigned Role</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Lockout State</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@u.FullName</div>
                        </td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge bg-danger text-white">Administrator</span>
                            }
                            else if (u.Role == "Manager")
                            {
                                <span class="badge bg-warning text-dark">Manager</span>
                            }
                            else
                            {
                                <span class="badge bg-primary text-white">Sales Executive</span>
                            }
                        </td>
                        <td>@(u.Department ?? "—")</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success text-white small">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white small">Deactivated</span>
                            }
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger text-white small"><i class="fa-solid fa-lock me-1"></i> LOCKED</span>
                            }
                            else if (u.FailedLoginCount > 0)
                            {
                                <span class="badge bg-light text-warning border small">@u.FailedLoginCount failed attempts</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-success border small">Normal</span>
                            }
                        </td>
                        <td>
                            <span class="small text-muted">@u.CreatedDate.ToString("MMM dd, yyyy")</span>
                        </td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 8px;">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@u.Id"><i class="fa-solid fa-pen-to-square me-2 text-muted"></i> Edit / Unlock</a></li>
                                    <li><a class="dropdown-item" asp-action="ResetPassword" asp-route-id="@u.Id"><i class="fa-solid fa-key me-2 text-warning"></i> Reset Password</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
