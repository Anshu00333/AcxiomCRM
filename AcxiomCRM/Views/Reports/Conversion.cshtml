@model AcxiomCRM.ViewModels.ConversionReportViewModel
@{
    ViewData["Title"] = "Sales Conversion Report";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Reports</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">Conversion Analytics</span>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Lead-to-Deal Conversion Analytics</h2>
        <p class="text-secondary small mb-0">Evaluate conversion funnel efficiency and deal outcome ratios.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Lead Conversion Card -->
    <div class="col-12 col-lg-6">
        <div class="card card-crm h-100">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-filter me-2 text-primary"></i> Lead Funnel Conversion</span>
            </div>
            <div class="card-body-crm">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <div class="text-muted small">Conversion Rate</div>
                        <div class="fw-bold fs-2 text-success">@Model.ConversionRatePercent%</div>
                    </div>
                    <div class="kpi-icon success"><i class="fa-solid fa-arrow-trend-up"></i></div>
                </div>

                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span>Total Prospects Captured</span>
                        <strong class="text-dark">@Model.TotalLeads</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span>Converted to Accounts / Deals</span>
                        <strong class="text-success">@Model.ConvertedLeads</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span>Marked as Unqualified / Lost</span>
                        <strong class="text-danger">@Model.LostLeads</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunity Win Rate Card -->
    <div class="col-12 col-lg-6">
        <div class="card card-crm h-100">
            <div class="card-header-crm">
                <span><i class="fa-solid fa-trophy me-2 text-warning"></i> Opportunity Win Rate</span>
            </div>
            <div class="card-body-crm">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <div class="text-muted small">Closed Deal Win Rate</div>
                        <div class="fw-bold fs-2 text-primary">@Model.WinRatePercent%</div>
                    </div>
                    <div class="kpi-icon primary"><i class="fa-solid fa-award"></i></div>
                </div>

                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span>Total Tracked Opportunities</span>
                        <strong class="text-dark">@Model.TotalOpportunities</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span>Won Opportunities</span>
                        <strong class="text-success">@Model.WonOpportunities</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span>Lost Opportunities</span>
                        <strong class="text-danger">@Model.LostOpportunities</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
