@model AcxiomCRM.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 p-3 shadow-sm mb-3">
                    <i class="fa-solid fa-layer-group fs-2"></i>
                </div>
                <h3 class="fw-bold text-dark">AcxiomCRM</h3>
                <p class="text-muted small">Register New Representative Account</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h4 class="fw-bold mb-1 text-dark">Create Account</h4>
                <p class="text-muted small mb-4">Please fill in your details to create an account.</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0" role="alert"></div>

                <form asp-action="Register" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label-crm">Full Name</label>
                        <input asp-for="FullName" class="form-control form-control-crm" placeholder="Johnathan Doe" />
                        <span asp-validation-for="FullName" class="text-danger-validation"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-crm">Work Email Address</label>
                        <input asp-for="Email" class="form-control form-control-crm" placeholder="john@company.com" />
                        <span asp-validation-for="Email" class="text-danger-validation"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label-crm">Requested Role</label>
                            <select asp-for="Role" class="form-select form-select-crm">
                                <option value="SalesExecutive">Sales Executive</option>
                                <option value="Manager">Manager</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger-validation"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label-crm">Department</label>
                            <input asp-for="Department" class="form-control form-control-crm" placeholder="Sales / Outreach" />
                            <span asp-validation-for="Department" class="text-danger-validation"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label-crm">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-crm" placeholder="Min. 8 characters with symbol & numbers" />
                        <div class="form-text small text-muted">Must contain uppercase, lowercase, digit, and special character.</div>
                        <span asp-validation-for="Password" class="text-danger-validation"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label-crm">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-crm" placeholder="Confirm your password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger-validation"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm mb-3">
                        <i class="fa-solid fa-user-plus me-2"></i> Register Account
                    </button>
                </form>

                <div class="mt-2 pt-3 border-top text-center small text-muted">
                    Already registered? <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
