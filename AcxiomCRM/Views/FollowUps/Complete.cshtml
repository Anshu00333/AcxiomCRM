@model AcxiomCRM.ViewModels.CompleteFollowUpViewModel
@{
    ViewData["Title"] = "Complete Follow-Up";
}

<div class="crm-breadcrumb">
    <a asp-action="Index">Follow-Ups</a>
    <i class="fa-solid fa-chevron-right small"></i>
    <span class="active">Complete Activity</span>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-crm">
            <div class="card-header-crm bg-light">
                <span><i class="fa-solid fa-circle-check me-2 text-success"></i> Complete Follow-Up: @Model.Subject</span>
            </div>
            <div class="card-body-crm">
                <form asp-action="Complete" method="post" class="crm-validate-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FollowUpId" />
                    <input type="hidden" asp-for="Subject" />
                    <input type="hidden" asp-for="Remarks" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

                    <div class="mb-3">
                        <label asp-for="OutcomeNotes" class="form-label-crm">Meeting / Call Outcome Notes <span class="text-danger">*</span></label>
                        <textarea asp-for="OutcomeNotes" rows="4" class="form-control form-control-crm" placeholder="Summarize the discussion, objections addressed, decisions made, or key next steps..."></textarea>
                        <span asp-validation-for="OutcomeNotes" class="text-danger-validation"></span>
                    </div>

                    <!-- Next Follow-up Scheduler -->
                    <div class="card p-3 mb-4 bg-light border rounded-3">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="ScheduleNext" class="form-check-input" id="checkScheduleNext" />
                            <label class="form-check-label fw-bold text-dark" for="checkScheduleNext">Schedule Next Follow-Up Interaction</label>
                        </div>

                        <div id="nextFollowUpFields" style="display: none;">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="NextFollowUpType" class="form-label-crm">Activity Type</label>
                                    <select asp-for="NextFollowUpType" class="form-select form-select-crm">
                                        <option value="Call">Phone Call</option>
                                        <option value="Meeting">Follow-Up Meeting</option>
                                        <option value="Email">Email Communication</option>
                                        <option value="Task">Action Item</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NextFollowUpDate" class="form-label-crm">Date & Time</label>
                                    <input asp-for="NextFollowUpDate" type="datetime-local" class="form-control form-control-crm" />
                                </div>
                            </div>
                            <div>
                                <label asp-for="NextSubject" class="form-label-crm">Next Subject / Focus</label>
                                <input asp-for="NextSubject" class="form-control form-control-crm" placeholder="e.g. Discuss revised proposal pricing" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-crm-outline">Cancel</a>
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="fa-solid fa-check me-1"></i> Save & Mark Completed
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('checkScheduleNext').addEventListener('change', function () {
            document.getElementById('nextFollowUpFields').style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
